{
  "name": "candle-engine",
  "private": true,
  "version": "0.0.0",
  "description": "Motor gráfico financiero de velas en AssemblyScript WASM SIMD sin asignaciones dinámicas, con Arena estática (< 1 MiB), wrapper TypeScript zero-copy, renderizadores WebGL2/Canvas2D, streams reales de Binance a 4 Hz y playground modular en SolidJS.",
  "author": "Edison Manrique Chocce",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build:wasm": "mkdir -p public/wasm && asc --config asconfig.json --target release",
    "build:wasm:debug": "mkdir -p public/wasm && asc --config asconfig.json --target debug",
    "build": "npm run build:wasm && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "assemblyscript": "^0.28.20",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "solid-js": "^1.9.16",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.17"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
